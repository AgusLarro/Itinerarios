<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chicago — 3 Días</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<style>
  :root {
    --navy: #0d1b2a;
    --steel: #1b3a52;
    --lake: #2a6fa8;
    --sky: #5ba4cf;
    --gold: #e8b84b;
    --warm: #f5efe6;
    --cream: #faf7f2;
    --rust: #c95c2e;
    --text: #1a1a2e;
    --muted: #6b7a8d;
    --border: #d4cdc4;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--text); overflow-x: hidden; }

  .hero {
    background: var(--navy);
    position: relative;
    overflow: hidden;
    padding: 60px 40px 50px;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .hero-grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(rgba(91,164,207,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(91,164,207,0.08) 1px, transparent 1px);
    background-size: 40px 40px;
  }
  .hero-skyline { position: absolute; bottom: 0; left: 0; right: 0; opacity: 0.12; }
  .hero-label { font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 3px; color: var(--sky); text-transform: uppercase; margin-bottom: 16px; position: relative; z-index: 2; }
  .hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(52px, 8vw, 96px); font-weight: 900; color: #fff; line-height: 0.92; position: relative; z-index: 2; letter-spacing: -2px; }
  .hero h1 em { font-style: italic; color: var(--gold); }
  .hero-sub { position: relative; z-index: 2; margin-top: 20px; display: flex; gap: 16px; flex-wrap: wrap; }
  .hero-pill { background: rgba(91,164,207,0.15); border: 1px solid rgba(91,164,207,0.3); color: var(--sky); padding: 6px 16px; border-radius: 20px; font-size: 12px; font-family: 'DM Mono', monospace; letter-spacing: 1px; }

  .opt-banner { background: var(--gold); padding: 14px 40px; display: flex; align-items: flex-start; gap: 12px; }
  .opt-banner-icon { font-size: 18px; flex-shrink: 0; margin-top: 2px; }
  .opt-banner p { font-size: 13px; font-weight: 500; color: var(--navy); line-height: 1.6; }
  .opt-banner strong { font-weight: 700; }

  .container { max-width: 1100px; margin: 0 auto; padding: 0 32px; }
  .day-section { padding: 56px 0 0; }
  .day-header { display: flex; align-items: flex-start; gap: 24px; margin-bottom: 36px; padding-bottom: 24px; border-bottom: 2px solid var(--border); }
  .day-number { font-family: 'Playfair Display', serif; font-size: 72px; font-weight: 900; color: var(--border); line-height: 1; flex-shrink: 0; margin-top: -8px; }
  .day-tag { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 3px; color: var(--lake); text-transform: uppercase; display: block; margin-bottom: 4px; }
  .day-title { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: var(--navy); margin-bottom: 6px; }
  .day-objective { font-size: 14px; color: var(--muted); font-weight: 300; }

  .day-blocks { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }
  .day-blocks.three { grid-template-columns: 1fr 1fr 1fr; }
  .block { background: #fff; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; }
  .block:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(13,27,42,0.1); }
  .block-header { padding: 14px 20px 12px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: flex-start; }
  .block-time { font-family: 'DM Mono', monospace; font-size: 11px; color: var(--lake); font-weight: 500; letter-spacing: 1px; }
  .block-badge { font-size: 10px; padding: 3px 10px; border-radius: 10px; font-family: 'DM Mono', monospace; letter-spacing: 0.5px; font-weight: 500; }
  .badge-walk  { background: #e8f4e8; color: #2d7a2d; }
  .badge-food  { background: #fef3e2; color: #c87000; }
  .badge-tour  { background: #e8eef8; color: #2a5fa8; }
  .badge-view  { background: #f3e8f8; color: #8a2ab8; }
  .badge-free  { background: #e8f8f3; color: #1a7a5a; }
  .badge-arch  { background: #fde8e8; color: #b03030; }
  .block-body { padding: 16px 20px; }
  .block-name { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: var(--navy); margin-bottom: 6px; }
  .block-desc { font-size: 13px; color: var(--muted); line-height: 1.6; font-weight: 300; margin-bottom: 10px; }
  .block-tips { list-style: none; }
  .block-tips li { font-size: 12px; color: var(--text); padding: 4px 0 4px 16px; position: relative; line-height: 1.4; }
  .block-tips li::before { content: '→'; position: absolute; left: 0; color: var(--gold); font-weight: 700; font-size: 10px; top: 5px; }
  .block-duration { font-family: 'DM Mono', monospace; font-size: 11px; color: var(--sky); margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--border); }
  .transport-tag { display: inline-flex; align-items: center; gap: 5px; background: var(--warm); border: 1px solid var(--border); padding: 4px 10px; border-radius: 6px; font-size: 11px; color: var(--muted); font-family: 'DM Mono', monospace; margin-top: 8px; }

  .opt-note { background: var(--navy); color: #fff; border-radius: 10px; padding: 14px 18px; margin-bottom: 20px; font-size: 12.5px; line-height: 1.6; display: flex; gap: 10px; align-items: flex-start; }
  .opt-note-icon { flex-shrink: 0; color: var(--gold); font-size: 14px; margin-top: 1px; }
  .opt-note em { color: var(--gold); font-style: normal; font-weight: 600; }

  .route-strip { background: var(--steel); border-radius: 10px; padding: 14px 20px; margin-bottom: 24px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .route-label { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 2px; color: var(--sky); text-transform: uppercase; margin-right: 4px; flex-shrink: 0; }
  .route-stop { background: rgba(255,255,255,0.1); color: #fff; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 500; white-space: nowrap; }
  .route-arrow { color: var(--gold); font-size: 14px; flex-shrink: 0; }

  .map-legend { display: flex; gap: 20px; flex-wrap: wrap; padding: 10px 16px; background: var(--warm); border: 1px solid var(--border); border-radius: 8px 8px 0 0; border-bottom: none; align-items: center; }
  .legend-title { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 2px; color: var(--muted); text-transform: uppercase; }
  .legend-item { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--text); font-weight: 500; }
  .legend-dot { width: 14px; height: 14px; border-radius: 50%; border: 2px solid rgba(0,0,0,0.15); flex-shrink: 0; }
  .legend-zone { width: 22px; height: 11px; border-radius: 3px; flex-shrink: 0; border: 1.5px dashed; opacity: 0.7; }

  .map-container { border-radius: 0 0 12px 12px; overflow: hidden; border: 1px solid var(--border); margin-bottom: 48px; height: 420px; position: relative; }

  .leaflet-tooltip.zone-label {
    background: transparent; border: none; box-shadow: none;
    font-size: 11px; font-weight: 700; color: #1a3a1a;
    font-family: 'DM Sans', sans-serif;
    white-space: pre-line; text-align: center;
  }

  .tips-section { background: var(--navy); padding: 48px 40px; margin-top: 56px; }
  .tips-title { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: #fff; margin-bottom: 28px; }
  .tips-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
  .tip-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 18px; }
  .tip-icon { font-size: 22px; margin-bottom: 10px; }
  .tip-card h4 { font-size: 14px; color: var(--gold); font-weight: 600; margin-bottom: 6px; }
  .tip-card p { font-size: 12px; color: rgba(255,255,255,0.65); line-height: 1.6; }

  .section-divider { border: none; border-top: 1px solid var(--border); }
  footer { background: var(--navy); border-top: 1px solid rgba(255,255,255,0.06); padding: 20px 40px; text-align: center; font-family: 'DM Mono', monospace; font-size: 11px; color: rgba(255,255,255,0.3); letter-spacing: 1px; }

  @media (max-width: 700px) {
    .day-blocks, .day-blocks.three { grid-template-columns: 1fr; }
    .hero { padding: 40px 24px 36px; }
    .container { padding: 0 20px; }
    .tips-section, .opt-banner { padding: 36px 24px; }
  }
</style>
</head>
<body>

<div class="hero">
  <div class="hero-grid"></div>
  <svg class="hero-skyline" viewBox="0 0 1200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="0" y="120" width="60" height="80" fill="white"/><rect x="65" y="90" width="40" height="110" fill="white"/>
    <rect x="110" y="60" width="30" height="140" fill="white"/><rect x="112" y="40" width="8" height="25" fill="white"/>
    <rect x="145" y="80" width="50" height="120" fill="white"/><rect x="200" y="100" width="35" height="100" fill="white"/>
    <rect x="240" y="50" width="45" height="150" fill="white"/><rect x="258" y="20" width="10" height="35" fill="white"/>
    <rect x="290" y="70" width="55" height="130" fill="white"/><rect x="350" y="95" width="40" height="105" fill="white"/>
    <rect x="395" y="55" width="35" height="145" fill="white"/><rect x="435" y="80" width="60" height="120" fill="white"/>
    <rect x="500" y="110" width="30" height="90" fill="white"/><rect x="535" y="65" width="50" height="135" fill="white"/>
    <rect x="590" y="40" width="40" height="160" fill="white"/><rect x="594" y="10" width="8" height="35" fill="white"/>
    <rect x="635" y="75" width="45" height="125" fill="white"/><rect x="685" y="95" width="55" height="105" fill="white"/>
    <rect x="745" y="60" width="35" height="140" fill="white"/><rect x="785" y="85" width="50" height="115" fill="white"/>
    <rect x="840" y="105" width="40" height="95" fill="white"/><rect x="885" y="70" width="60" height="130" fill="white"/>
    <rect x="950" y="90" width="35" height="110" fill="white"/><rect x="990" y="55" width="45" height="145" fill="white"/>
    <rect x="1040" y="80" width="50" height="120" fill="white"/><rect x="1095" y="100" width="40" height="100" fill="white"/>
    <rect x="1140" y="115" width="60" height="85" fill="white"/>
  </svg>
  <div class="hero-label">✦ Itinerario optimizado · 3 días</div>
  <h1>Chi<em>cago</em></h1>
  <div class="hero-sub">
    <span class="hero-pill">🛬 Llegada al mediodía Día 1</span>
    <span class="hero-pill">🚇 Red Line + Uber</span>
    <span class="hero-pill">📍 11 atracciones</span>
    <span class="hero-pill">🍽 5 paradas gastronómicas</span>
  </div>
</div>

<div class="opt-banner">
  <span class="opt-banner-icon">⚡</span>
  <p><strong>Reorganización aplicada:</strong> Día 1 (llegada al mediodía) → Hyde Park + U. de Chicago + Jackson Park, zona compacta al sur ideal para tarde tranquila. Pilsen eliminado. El 360 Chicago (sunset) se movió al Día 2 encadenado con Wendella Tours y Quartino — los tres en el Magnificent Mile, todos a pie. Día 3 queda para el recorrido icónico del Loop con toda la energía.</p>
</div>

<div class="container">

  <!-- ══════════ DÍA 1 ══════════ -->
  <div class="day-section">
    <div class="day-header">
      <div class="day-number">01</div>
      <div class="day-info">
        <span class="day-tag">Sábado · Llegada al mediodía</span>
        <div class="day-title">Hyde Park, campus & lago sur</div>
        <div class="day-objective">Tarde tranquila lejos del ruido turístico — arquitectura tipo Oxford, parque japonés y primera vista al lago</div>
      </div>
    </div>

    <div class="opt-note">
      <span class="opt-note-icon">★</span>
      <span>Llegás al mediodía: <em>Hyde Park es perfecto</em> para estrenar las piernas sin la presión del centro. Todo está a 25–35 min en Uber desde O'Hare o Midway. Zona segura, tranquila, con arquitectura increíble. Guardá el centro para los días siguientes cuando tengas más energía.</span>
    </div>

    <div class="route-strip">
      <span class="route-label">Ruta</span>
      <span class="route-stop">🛬 Aeropuerto</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🏛 U. de Chicago</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🌳 Jackson Park</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🏖 Lago Michigan</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🍽 Cena Hyde Park</span>
    </div>

    <div class="day-blocks three">
      <div class="block">
        <div class="block-header">
          <span class="block-time">13:00 – 15:00</span>
          <span class="block-badge badge-arch">🏛 Campus</span>
        </div>
        <div class="block-body">
          <div class="block-name">University of Chicago</div>
          <div class="block-desc">Campus neogótico que parece Oxford trasplantado a Illinois. Edificios cubiertos de hiedra, patios interiores y una atmósfera académica inigualable. Libre acceso.</div>
          <ul class="block-tips">
            <li>Cobb Gate y el Main Quadrangle — los puntos más fotogénicos</li>
            <li>Oriental Institute Museum (ISAC) — gratis, colección egipcia extraordinaria</li>
            <li>Robie House de Frank Lloyd Wright está a 2 cuadras (exterior libre)</li>
          </ul>
          <div class="block-duration">⏱ ~2 horas · Libre acceso</div>
          <div class="transport-tag">🚗 Uber desde aeropuerto ~25–35 min</div>
        </div>
      </div>

      <div class="block">
        <div class="block-header">
          <span class="block-time">15:00 – 17:00</span>
          <span class="block-badge badge-free">🌳 Parque</span>
        </div>
        <div class="block-body">
          <div class="block-name">Jackson Park & Jardín Japonés</div>
          <div class="block-desc">El parque donde se realizó la Exposición Universal de 1893. El Jardín Botánico Japonés en la isla Wooded Island es uno de los rincones más inesperadamente tranquilos de Chicago.</div>
          <ul class="block-tips">
            <li>Cruzar el puente a Wooded Island para el jardín japonés</li>
            <li>63rd Street Beach: primera vista al lago desde el sur, muy local</li>
            <li>La Obama Presidential Library se está construyendo aquí</li>
          </ul>
          <div class="block-duration">⏱ ~2 horas · Libre</div>
          <div class="transport-tag">🚶 10 min a pie desde la Universidad</div>
        </div>
      </div>

      <div class="block">
        <div class="block-header">
          <span class="block-time">19:00 – cierre</span>
          <span class="block-badge badge-food">🍽 Cena</span>
        </div>
        <div class="block-body">
          <div class="block-name">Cena en Hyde Park</div>
          <div class="block-desc">Primera noche sin necesidad de ir al centro. Ambiente universitario, opciones sólidas y cero turismo masivo.</div>
          <ul class="block-tips">
            <li><strong>Virtue Restaurant</strong> — cocina del sur de EE.UU., muy reconocido en Chicago</li>
            <li><strong>Medici on 57th</strong> — clásico del barrio desde 1962, hamburguesas y pizza</li>
            <li>Alternativa: Uber al Loop (~15 min) si querés salir a explorar de noche</li>
          </ul>
          <div class="block-duration">⏱ ~1.5 horas</div>
          <div class="transport-tag">📍 57th Street, corazón de Hyde Park</div>
        </div>
      </div>
    </div>

    <div class="map-legend">
      <span class="legend-title">Referencias del mapa</span>
      <span class="legend-item"><span class="legend-dot" style="background:#2563a8"></span>Atracción turística</span>
      <span class="legend-item"><span class="legend-dot" style="background:#d97706"></span>Comida / Restaurante</span>
      <span class="legend-item"><span class="legend-zone" style="background:#16a34a;border-color:#16a34a"></span>Zona para caminar</span>
    </div>
    <div class="map-container" id="map1"></div>
  </div>

  <hr class="section-divider">

  <!-- ══════════ DÍA 2 ══════════ -->
  <div class="day-section">
    <div class="day-header">
      <div class="day-number">02</div>
      <div class="day-info">
        <span class="day-tag">Domingo · Arquitectura, río & atardecer</span>
        <div class="day-title">Lincoln Park, barco al atardecer y piso 94</div>
        <div class="day-objective">Del zoo gratuito al mejor sunset de la ciudad — todo encadenado en el Magnificent Mile sin traslados</div>
      </div>
    </div>

    <div class="opt-note">
      <span class="opt-note-icon">⚡</span>
      <span><em>Encadenamiento perfecto:</em> Wendella Tours termina en el Riverwalk (400 N Michigan Ave). El 360 Chicago está a <em>5 min a pie hacia el norte</em> por Michigan Ave (875 N Michigan). Quartino queda a <em>4 cuadras del 360</em> (626 N State). Los tres en el Magnificent Mile — sin ningún Uber entre ellos.</span>
    </div>

    <div class="route-strip">
      <span class="route-label">Ruta</span>
      <span class="route-stop">🚇 Red Line → Fullerton</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🦁 Lincoln Park Zoo</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🌊 Vista Lago Norte</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🥩 Mr. Beef</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🚢 Wendella</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🌆 360 Chicago</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🍝 Quartino</span>
    </div>

    <div class="day-blocks">
      <div class="block">
        <div class="block-header">
          <span class="block-time">09:00 – 11:30</span>
          <span class="block-badge badge-free">🦁 Gratis</span>
        </div>
        <div class="block-body">
          <div class="block-name">Lincoln Park Zoo + Vista Lago Norte</div>
          <div class="block-desc">El zoo gratuito más visitado de EE.UU., dentro de uno de los mejores parques de Chicago. Terminar caminando al lago para la vista del skyline desde el norte.</div>
          <ul class="block-tips">
            <li>Gorilla House y Sea Lion Pool son los highlights del zoo</li>
            <li>Caminar al Lakefront Trail → vista del skyline desde el norte, única</li>
            <li>Lincoln Park Conservatory está pegado al zoo, también gratis</li>
          </ul>
          <div class="block-duration">⏱ ~2.5 horas · Libre</div>
          <div class="transport-tag">🚇 Red Line → Fullerton (15 min)</div>
        </div>
      </div>

      <div class="block">
        <div class="block-header">
          <span class="block-time">12:00 – 13:00</span>
          <span class="block-badge badge-food">🥩 Almuerzo</span>
        </div>
        <div class="block-body">
          <div class="block-name">Mr. Beef — Italian Beef Sandwich</div>
          <div class="block-desc">Ícono de Chicago, famoso por la serie The Bear. Sin pretensiones, mesa comunitaria, el Italian Beef más auténtico de la ciudad.</div>
          <ul class="block-tips">
            <li>Pedir "juicy" — bien empapado en el au jus</li>
            <li>Cash es más rápido, aunque aceptan tarjeta</li>
            <li><strong>Importante:</strong> cierra a las 16:00 y los domingos podría no abrir — verificar antes</li>
          </ul>
          <div class="block-duration">⏱ ~1 hora · $ económico</div>
          <div class="transport-tag">🚗 Uber desde Lincoln Park ~10 min</div>
        </div>
      </div>

      <div class="block">
        <div class="block-header">
          <span class="block-time">15:30 – 17:15</span>
          <span class="block-badge badge-tour">🚢 Tour</span>
        </div>
        <div class="block-body">
          <div class="block-name">Wendella — Tour de Arquitectura (90 min)</div>
          <div class="block-desc">Navegar el río Chicago con guía experto. El mejor modo de entender el skyline de la ciudad. Elegir horario de tarde para tener el sol bajando sobre los edificios.</div>
          <ul class="block-tips">
            <li>Reservar online — los horarios de tarde/sunset se llenan</li>
            <li>Llegar 30 min antes al nivel Riverwalk del Wrigley Building</li>
            <li>Sentarse en cubierta exterior para mejores ángulos de foto</li>
          </ul>
          <div class="block-duration">⏱ 90 min · ~$45 USD</div>
          <div class="transport-tag">📍 400 N Michigan Ave — Riverwalk level</div>
        </div>
      </div>

      <div class="block">
        <div class="block-header">
          <span class="block-time">17:30 – 19:00</span>
          <span class="block-badge badge-view">🌆 Sunset</span>
        </div>
        <div class="block-body">
          <div class="block-name">360 Chicago — Piso 94</div>
          <div class="block-desc">A 5 minutos a pie desde Wendella por Michigan Ave. Desde el piso 94 del Hancock Center: lago, skyline y el mejor atardecer de la ciudad. El TILT vale la pena.</div>
          <ul class="block-tips">
            <li>5 min caminando hacia el norte desde Wendella</li>
            <li>Trago en el Cloud Bar mientras oscurece — completar la experiencia</li>
            <li>TILT (~$15 extra): te inclinás hacia afuera sobre Michigan Ave</li>
          </ul>
          <div class="block-duration">⏱ ~1.5 horas · ~$35–40 USD entrada</div>
          <div class="transport-tag">🚶 5 min a pie desde Wendella</div>
        </div>
      </div>

      <div class="block">
        <div class="block-header">
          <span class="block-time">19:30 – cierre</span>
          <span class="block-badge badge-food">🍝 Cena</span>
        </div>
        <div class="block-body">
          <div class="block-name">Quartino Ristorante</div>
          <div class="block-desc">Italiano animado, ideal para grupos. A 4 cuadras del 360 Chicago — ir caminando. Platos para compartir y ambiente vibrante para cerrar la noche.</div>
          <ul class="block-tips">
            <li>Pizza margherita + gnocchi + penne alla vodka para compartir</li>
            <li>El tiramisu cubierto de espresso es obligatorio</li>
            <li>Abre hasta las 12:30 AM — sin apuro</li>
          </ul>
          <div class="block-duration">⏱ ~1.5 horas · $$ precio medio</div>
          <div class="transport-tag">🚶 4 cuadras a pie desde el 360</div>
        </div>
      </div>
    </div>

    <div class="map-legend">
      <span class="legend-title">Referencias del mapa</span>
      <span class="legend-item"><span class="legend-dot" style="background:#2563a8"></span>Atracción turística</span>
      <span class="legend-item"><span class="legend-dot" style="background:#d97706"></span>Comida / Restaurante</span>
      <span class="legend-item"><span class="legend-zone" style="background:#16a34a;border-color:#16a34a"></span>Zona para caminar</span>
      <span class="legend-item"><span class="legend-zone" style="background:#7c3aed;border-color:#7c3aed"></span>Clúster a pie</span>
    </div>
    <div class="map-container" id="map2"></div>
  </div>

  <hr class="section-divider">

  <!-- ══════════ DÍA 3 ══════════ -->
  <div class="day-section">
    <div class="day-header">
      <div class="day-number">03</div>
      <div class="day-info">
        <span class="day-tag">Lunes · El clásico de Chicago</span>
        <div class="day-title">Riverwalk, The Bean y el lago</div>
        <div class="day-objective">El recorrido más icónico a pie, de oeste a este, hecho con toda la energía y ya conociendo la ciudad</div>
      </div>
    </div>

    <div class="opt-note">
      <span class="opt-note-icon">★</span>
      <span>Guardaste el recorrido más fotogénico para el final: todo es a pie en línea hacia el este, sin subir a ningún transporte. Es el "primer contacto" clásico de Chicago — pero haciéndolo con calma, con contexto y sin apuro. El mejor modo de cerrar el viaje.</span>
    </div>

    <div class="route-strip">
      <span class="route-label">Ruta</span>
      <span class="route-stop">🚇 Red Line → Lake/Jackson</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🌊 Riverwalk</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🌉 Wacker / Puentes</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🫘 Millennium Park</span>
      <span class="route-arrow">→</span>
      <span class="route-stop">🏖 Lago Michigan</span>
    </div>

    <div class="day-blocks three">
      <div class="block">
        <div class="block-header">
          <span class="block-time">09:30 – 11:30</span>
          <span class="block-badge badge-walk">🌊 Río</span>
        </div>
        <div class="block-body">
          <div class="block-name">Chicago Riverwalk</div>
          <div class="block-desc">El paseo más cinematográfico del Loop. Caminar hacia el este alternando entre el nivel inferior (río) y Wacker Drive (calle) para distintas perspectivas del skyline.</div>
          <ul class="block-tips">
            <li>Bajar al nivel río apenas llegás — perspectiva única desde abajo</li>
            <li>Los puentes levadizos de Wacker: mejor punto de foto del skyline</li>
            <li>Cafés sobre el Riverwalk para arrancar con desayuno</li>
          </ul>
          <div class="block-duration">⏱ ~2 horas · Libre</div>
          <div class="transport-tag">🚇 Red Line → Lake o Jackson</div>
        </div>
      </div>

      <div class="block">
        <div class="block-header">
          <span class="block-time">11:30 – 13:30</span>
          <span class="block-badge badge-walk">🫘 Ícono</span>
        </div>
        <div class="block-body">
          <div class="block-name">Millennium Park & The Bean</div>
          <div class="block-desc">Cloud Gate: el espejo de acero que refleja el skyline entero. También Jay Pritzker Pavilion (Gehry), Crown Fountain y los jardines. Uno de los mejores parques urbanos del mundo.</div>
          <ul class="block-tips">
            <li>Meterse debajo del Bean para el efecto espejo completo del skyline</li>
            <li>Crown Fountain (las torres con caras que largan agua) con sol es increíble</li>
            <li>Jay Pritzker Pavilion al fondo — menos gente, muy fotogénico</li>
          </ul>
          <div class="block-duration">⏱ ~2 horas · Libre</div>
          <div class="transport-tag">🚶 A pie desde el Riverwalk</div>
        </div>
      </div>

      <div class="block">
        <div class="block-header">
          <span class="block-time">13:30 – 15:30</span>
          <span class="block-badge badge-free">🏖 Lago</span>
        </div>
        <div class="block-body">
          <div class="block-name">Lago Michigan — Grant Park Lakefront</div>
          <div class="block-desc">El cierre perfecto: desde la orilla mirando hacia el oeste tenés el skyline entero de Chicago. Es la postal más conocida de la ciudad, y desde ahí se entiende todo.</div>
          <ul class="block-tips">
            <li>Monroe Harbor: el punto exacto para la foto del skyline completo</li>
            <li>En días claros el agua tiene un azul profundo increíble</li>
            <li>Lakefront Trail: caminar al norte o sur según energía</li>
          </ul>
          <div class="block-duration">⏱ ~2 horas · Libre</div>
          <div class="transport-tag">🚶 A pie desde Millennium Park</div>
        </div>
      </div>
    </div>

    <div class="opt-note">
      <span class="opt-note-icon">🍕</span>
      <span>Almuerzo Día 3: <em>Lou Malnati's</em> (439 N Wells, River North) — deep dish pizza, última experiencia gastronómica obligatoria. A 10 min a pie del Riverwalk. Alternativa rápida: <em>Portillo's</em> (100 W Ontario St) para hot dog estilo Chicago.</span>
    </div>

    <div class="map-legend">
      <span class="legend-title">Referencias del mapa</span>
      <span class="legend-item"><span class="legend-dot" style="background:#2563a8"></span>Atracción turística</span>
      <span class="legend-item"><span class="legend-dot" style="background:#d97706"></span>Comida / Restaurante</span>
      <span class="legend-item"><span class="legend-zone" style="background:#0284c7;border-color:#0284c7"></span>Zona para caminar</span>
      <span class="legend-item"><span class="legend-zone" style="background:#d97706;border-color:#d97706"></span>Zona gastronómica</span>
    </div>
    <div class="map-container" id="map3"></div>
  </div>

</div><!-- /container -->

<!-- TIPS -->
<div class="tips-section">
  <div class="container">
    <div class="tips-title">Consejos generales</div>
    <div class="tips-grid">
      <div class="tip-card">
        <div class="tip-icon">🚇</div>
        <h4>Transporte</h4>
        <p>Red Line como eje norte-sur. Comprar Ventra Card al llegar ($5 tarjeta + carga). Uber para Hyde Park, Jackson Park y de noche cuando están cansados.</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">🌡️</div>
        <h4>Clima variable</h4>
        <p>Chicago puede cambiar 15°C en un día. Llevar abrigo liviano siempre. El viento cerca del lago es persistente incluso en verano. La estrategia es capas.</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">🎒</div>
        <h4>No sobrecargar</h4>
        <p>Disfrutar zonas más que tachar lugares. Perderse en un barrio interesante suele ser mejor que correr entre atracciones. Tener 1–2 ítems "si da el tiempo".</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">💳</div>
        <h4>Dinero</h4>
        <p>Mr. Beef: preferir efectivo (más rápido). Resto de lugares acepta tarjeta sin problema. Propina estándar 18–20% — es parte del salario del personal.</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">📸</div>
        <h4>Las 4 fotos clave</h4>
        <p>Skyline desde el norte del lago (Lincoln Park), desde abajo del Bean, desde los puentes de Wacker a nivel río, y el sunset desde el piso 94. Las cuatro distintas, las cuatro imprescindibles.</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">🔒</div>
        <h4>Seguridad</h4>
        <p>Hyde Park, Lincoln Park, River North, el Loop y el Magnificent Mile son zonas muy seguras para turistas. De noche, Uber de regreso al hotel siempre.</p>
      </div>
    </div>
  </div>
</div>

<footer>Chicago · 3 días · Itinerario optimizado por proximidad y tiempo</footer>

<script>
// ── Helpers ───────────────────────────────────────────────────────────────
function addTiles(map) {
  L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
    attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> © <a href="https://carto.com/">CARTO</a>',
    subdomains: 'abcd', maxZoom: 19
  }).addTo(map);
}

// Marcador azul = atracción turística (pin con número)
function icoAttraction(num) {
  return L.divIcon({
    className: '',
    html: `<div style="background:#2563a8;color:#fff;width:32px;height:32px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:2.5px solid #fff;box-shadow:0 3px 10px rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;"><span style="transform:rotate(45deg);font-size:13px;font-weight:800;font-family:sans-serif">${num}</span></div>`,
    iconSize: [32,32], iconAnchor: [16,32], popupAnchor: [0,-34]
  });
}

// Marcador naranja = comida/restaurante (cuadrado redondeado con emoji)
function icoFood(emoji) {
  return L.divIcon({
    className: '',
    html: `<div style="background:#d97706;color:#fff;width:36px;height:36px;border-radius:8px;border:2.5px solid #fff;box-shadow:0 3px 10px rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;font-size:17px;">${emoji}</div>`,
    iconSize: [36,36], iconAnchor: [18,18], popupAnchor: [0,-20]
  });
}

function addRoute(map, pts, color) {
  L.polyline(pts, { color, weight: 4, opacity: 0.75, dashArray: '9,7', lineJoin: 'round' }).addTo(map);
}

function addZone(map, sw, ne, label, fillColor, textColor) {
  textColor = textColor || '#1a3a1a';
  L.rectangle([sw, ne], {
    color: fillColor, weight: 2, opacity: 0.55,
    fillColor: fillColor, fillOpacity: 0.10, dashArray: '6,5'
  }).addTo(map).bindTooltip(label, {
    permanent: true, direction: 'center',
    className: 'zone-label',
    offset: [0,0]
  });
}

function pop(title, body) {
  return `<div style="font-family:sans-serif;min-width:170px;max-width:220px"><b style="font-size:13px;color:#0d1b2a;line-height:1.3">${title}</b><br><span style="font-size:11px;color:#555;line-height:1.5">${body}</span></div>`;
}

// CSS para los tooltip de zona
const style = document.createElement('style');
style.textContent = `.zone-label{background:transparent!important;border:none!important;box-shadow:none!important;font-size:11px!important;font-weight:700!important;font-family:'DM Sans',sans-serif!important;white-space:pre-line!important;text-align:center!important;pointer-events:none!important;}`;
document.head.appendChild(style);

// ── DÍA 1: Hyde Park ──────────────────────────────────────────────────────
(function(){
  const map = L.map('map1', { zoomControl:true, scrollWheelZoom:false });
  addTiles(map);

  // Zonas
  addZone(map, [41.776,-87.614], [41.802,-87.593], '🏘 Hyde Park\nzona segura p/caminar', '#16a34a');
  addZone(map, [41.774,-87.590], [41.790,-87.572], '🌳 Jackson Park', '#15803d');

  const attr = [
    { ll:[41.7919,-87.6028], n:'1', t:'🏛 University of Chicago', d:'Campus neogótico. Main Quad, Cobb Gate. Oriental Institute gratis.' },
    { ll:[41.7879,-87.5996], n:'2', t:'🏠 Robie House (F.L.Wright)', d:'Obra maestra Prairie Style. A 2 cuadras del campus.' },
    { ll:[41.7808,-87.5802], n:'3', t:'🌳 Jackson Park + Jardín Japonés', d:'Wooded Island. Jardín japonés tranquilo, Obama Library en construcción.' },
    { ll:[41.7773,-87.5757], n:'4', t:'🏖 63rd Street Beach', d:'Primera vista al Lago Michigan. Muy local y tranquila.' },
  ];
  const food = [
    { ll:[41.7935,-87.5978], e:'🍽', t:'Virtue Restaurant', d:'Cocina del sur de EE.UU. Muy reconocido.' },
    { ll:[41.7909,-87.5984], e:'🍔', t:'Medici on 57th', d:'Clásico desde 1962. Hamburguesas y pizza.' },
  ];

  addRoute(map, attr.map(a=>a.ll), '#2563a8');
  attr.forEach(a => L.marker(a.ll,{icon:icoAttraction(a.n)}).addTo(map).bindPopup(pop(a.t,a.d)));
  food.forEach(f => L.marker(f.ll,{icon:icoFood(f.e)}).addTo(map).bindPopup(pop(f.t,f.d)));

  map.fitBounds([[41.771,-87.617],[41.802,-87.570]], {padding:[28,28]});
})();

// ── DÍA 2: Lincoln Park → Magnificent Mile ────────────────────────────────
(function(){
  const map = L.map('map2', { zoomControl:true, scrollWheelZoom:false });
  addTiles(map);

  addZone(map, [41.912,-87.642], [41.929,-87.624], '🌿 Lincoln Park\nzoo + lago', '#16a34a');
  addZone(map, [41.884,-87.629], [41.902,-87.619], '✨ Magnificent Mile\nWendella → 360 → Quartino (a pie)', '#7c3aed');
  addZone(map, [41.887,-87.641], [41.899,-87.626], '🍸 River North\nbares & rooftops', '#0891b2');

  const attr = [
    { ll:[41.9217,-87.6336], n:'1', t:'🦁 Lincoln Park Zoo', d:'Gratis. Gorilla House, Sea Lion Pool. Llegar temprano.' },
    { ll:[41.9195,-87.6270], n:'2', t:'🌊 Lakefront Norte', d:'Vista del skyline desde el norte — la más especial y menos turística.' },
    { ll:[41.8892,-87.6245], n:'3', t:'🚢 Wendella Tours', d:'Tour arquitectura 90 min. Riverwalk level, Wrigley Building.' },
    { ll:[41.8990,-87.6232], n:'4', t:'🌆 360 Chicago – Piso 94', d:'5 min a pie desde Wendella. Sunset + lago + TILT ($15 extra).' },
    { ll:[41.8936,-87.6285], n:'5', t:'🍝 Quartino Ristorante', d:'4 cuadras del 360. Pizza + pasta + tiramisu.' },
  ];
  const food = [
    { ll:[41.8944,-87.6374], e:'🥩', t:'Mr. Beef', d:'Italian Beef Sandwich. Pedir "juicy". Verificar horario domingos.' },
  ];

  const routePts = [
    [41.9217,-87.6336],[41.9195,-87.6270],
    [41.8944,-87.6374], // Mr. Beef (desvío)
    [41.8892,-87.6245],[41.8990,-87.6232],[41.8936,-87.6285]
  ];
  addRoute(map, routePts, '#2563a8');
  attr.forEach(a => L.marker(a.ll,{icon:icoAttraction(a.n)}).addTo(map).bindPopup(pop(a.t,a.d)));
  food.forEach(f => L.marker(f.ll,{icon:icoFood(f.e)}).addTo(map).bindPopup(pop(f.t,f.d)));

  map.fitBounds([[41.883,-87.646],[41.930,-87.617]], {padding:[28,28]});
})();

// ── DÍA 3: Loop → Riverwalk → Lago ───────────────────────────────────────
(function(){
  const map = L.map('map3', { zoomControl:true, scrollWheelZoom:false });
  addTiles(map);

  addZone(map, [41.884,-87.633], [41.891,-87.614], '🌊 Riverwalk & Wacker\ncaminar a ambos niveles', '#0284c7');
  addZone(map, [41.878,-87.626], [41.886,-87.618], '🫘 Millennium Park\nThe Bean, Crown Fountain', '#16a34a');
  addZone(map, [41.866,-87.622], [41.880,-87.609], '🏖 Grant Park & Lago\nMichigan postal clásica', '#0891b2');
  addZone(map, [41.887,-87.641], [41.897,-87.628], '🍽 River North\nLou Malnati\'s / Portillo\'s', '#d97706');

  const attr = [
    { ll:[41.8884,-87.6232], n:'1', t:'🌊 Chicago Riverwalk', d:'Bajar al nivel río. Caminar hacia el este. Los puentes son el punto de foto.' },
    { ll:[41.8862,-87.6255], n:'2', t:'🌉 Wacker Drive / Puentes', d:'Subir a nivel calle para ver los puentes levadizos y el skyline en perspectiva.' },
    { ll:[41.8827,-87.6233], n:'3', t:'🫘 The Bean – Cloud Gate', d:'El espejo del skyline. Meterse debajo para el reflejo completo.' },
    { ll:[41.8757,-87.6196], n:'4', t:'🏖 Lago Michigan – Monroe Harbor', d:'La postal clásica: skyline completo desde la orilla del lago.' },
  ];
  const food = [
    { ll:[41.8903,-87.6337], e:'🍕', t:"Lou Malnati's", d:'Deep dish pizza. Pedir con 30 min de antelación.' },
    { ll:[41.8935,-87.6315], e:'🌭', t:"Portillo's", d:'Opción rápida. Chicago-style hot dog & Italian beef.' },
  ];

  addRoute(map, attr.map(a=>a.ll), '#2563a8');
  attr.forEach(a => L.marker(a.ll,{icon:icoAttraction(a.n)}).addTo(map).bindPopup(pop(a.t,a.d)));
  food.forEach(f => L.marker(f.ll,{icon:icoFood(f.e)}).addTo(map).bindPopup(pop(f.t,f.d)));

  map.fitBounds([[41.863,-87.645],[41.893,-87.606]], {padding:[28,28]});
})();
</script>

</body>
</html>
