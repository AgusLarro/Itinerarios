<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Itinerario USA 2025</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <style>
        :root {
            --navy:       #1a2744;
            --navy-mid:   #243660;
            --gold:       #c9a84c;
            --gold-light: #e8c97a;
            --gold-pale:  rgba(201,168,76,0.11);
            --cream:      #f7f4ee;
            --white:      #ffffff;
            --gray:       #6b7280;
            --light-gray: #f3f4f6;
            --border:     #e5e7eb;
            --orange:     #d97706;
        }

        * { margin:0; padding:0; box-sizing:border-box; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--cream);
            color: var(--navy);
            min-height: 100vh;
        }

        /* ── HERO ── */
        .hero {
            background: var(--navy);
            padding: 68px 20px 0;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                repeating-linear-gradient(0deg,  transparent, transparent 48px, rgba(255,255,255,.022) 48px, rgba(255,255,255,.022) 49px),
                repeating-linear-gradient(90deg, transparent, transparent 48px, rgba(255,255,255,.022) 48px, rgba(255,255,255,.022) 49px);
        }
        .hero-inner { position:relative; z-index:1; }
        .hero-eyebrow {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 14px;
        }
        .hero-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.6rem,6vw,4.4rem);
            color: var(--white);
            line-height: 1.1;
            margin-bottom: 12px;
        }
        .hero-sub {
            font-size: 13px;
            color: rgba(255,255,255,.4);
            font-weight: 300;
            letter-spacing: 3.5px;
            text-transform: uppercase;
            margin-bottom: 42px;
        }

        /* ── SWITCHER ── */
        .switch-wrap {
            background: var(--navy);
            padding: 0 20px 30px;
            display: flex;
            justify-content: center;
        }
        .switcher {
            background: rgba(255,255,255,.07);
            border-radius: 50px;
            padding: 5px;
            display: flex;
            gap: 4px;
        }
        .city-btn {
            padding: 11px 40px;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            font-weight: 500;
            transition: all .25s ease;
            background: transparent;
            color: rgba(255,255,255,.5);
        }
        .city-btn.active { background:var(--gold); color:var(--navy); font-weight:700; }
        .city-btn:hover:not(.active) { color:var(--white); }

        /* ── VIEWS ── */
        .city-view { display:none; }
        .city-view.active { display:block; }

        /* ── CITY INTRO ── */
        .city-intro {
            background: var(--navy);
            padding: 38px 20px 46px;
            text-align: center;
        }
        .city-tag {
            display: inline-block;
            border: 1px solid rgba(201,168,76,.5);
            color: var(--gold);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            padding: 5px 16px;
            border-radius: 20px;
            margin-bottom: 14px;
        }
        .city-intro h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.2rem,5vw,3.4rem);
            color: var(--white);
            margin-bottom: 10px;
        }
        .city-intro p {
            font-size: 14px;
            color: rgba(255,255,255,.45);
            max-width: 460px;
            margin: 0 auto;
            line-height: 1.65;
            font-weight: 300;
        }

        /* ── CONTAINER ── */
        .container {
            max-width: 780px;
            margin: 0 auto;
            padding: 44px 20px 88px;
        }

        /* ── DAY HEADER ── */
        .day-header {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 20px;
            padding-bottom: 18px;
            border-bottom: 2px solid var(--gold);
        }
        .day-num {
            font-family: 'Playfair Display', serif;
            font-size: 58px;
            font-weight: 700;
            color: var(--gold);
            line-height: 1;
            opacity: .7;
        }
        .day-meta h2 {
            font-family: 'Playfair Display', serif;
            font-size: 21px;
            color: var(--navy);
            margin-bottom: 4px;
        }
        .day-sub { font-size:12.5px; color:var(--gray); }

        /* ── CARD ── */
        .card {
            background: var(--white);
            border-radius: 16px;
            padding: 28px 26px;
            margin-bottom: 14px;
            box-shadow: 0 2px 18px rgba(26,39,68,.07);
        }

        /* ── OBJECTIVE ── */
        .objective {
            display: inline-flex;
            background: var(--gold-pale);
            border: 1px solid rgba(201,168,76,.35);
            color: #7a5c10;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .5px;
            text-transform: uppercase;
            padding: 5px 13px;
            border-radius: 20px;
            margin-bottom: 22px;
        }

        /* ── BLOCK ── */
        .block { margin-bottom:22px; }
        .block:last-child { margin-bottom:0; }
        .block + .block { padding-top:20px; border-top:1px solid var(--border); }

        .block-title {
            font-family: 'Playfair Display', serif;
            font-size: 16px;
            font-weight: 700;
            color: var(--navy);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .time-pill {
            background: var(--navy);
            color: var(--white);
            font-size: 10px;
            font-weight: 700;
            font-family: 'DM Sans', sans-serif;
            padding: 3px 10px;
            border-radius: 20px;
            letter-spacing: .5px;
        }

        /* ── TRANSPORT ── */
        .transport {
            display: flex;
            align-items: center;
            gap: 9px;
            background: var(--light-gray);
            padding: 9px 14px;
            border-radius: 9px;
            font-size: 13px;
            color: #4b5563;
            margin-bottom: 13px;
        }

        /* ── ROUTE LABEL ── */
        .route-label {
            font-size: 10.5px;
            font-weight: 700;
            color: var(--gold);
            letter-spacing: 1.2px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        /* ── STEPS ── */
        .steps { list-style:none; counter-reset:step; }
        .steps li {
            counter-increment: step;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 9px 0;
            border-bottom: 1px solid var(--border);
            font-size: 13.5px;
            line-height: 1.55;
            color: #374151;
        }
        .steps li:last-child { border-bottom:none; padding-bottom:0; }
        .steps li::before {
            content: counter(step);
            min-width: 22px; height: 22px;
            background: var(--navy);
            color: var(--white);
            border-radius: 50%;
            font-size: 10.5px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 2px;
        }

        /* ── TIPS ── */
        .tips { list-style:none; }
        .tips li {
            display: flex;
            gap: 9px;
            padding: 6px 0;
            font-size: 13.5px;
            line-height: 1.55;
            color: #4b5563;
        }
        .tips li::before { content:'→'; color:var(--gold); font-weight:700; flex-shrink:0; }

        /* ── HIGHLIGHT BOX ── */
        .highlight {
            background: var(--navy);
            border-radius: 12px;
            padding: 14px 18px;
            margin-top: 13px;
        }
        .hl-label {
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 5px;
        }
        .highlight p { font-size:13.5px; color:rgba(255,255,255,.85); line-height:1.55; }

        /* ── WARNING ── */
        .warning {
            background: rgba(201,168,76,.09);
            border-left: 3px solid var(--gold);
            border-radius: 0 9px 9px 0;
            padding: 11px 15px;
            margin-top: 12px;
        }
        .warning p { font-size:13px; color:#7a5c10; line-height:1.55; }

        /* ── OPTIONS (Starbucks) ── */
        .options { display:grid; gap:9px; margin-top:13px; }
        .opt { border-radius:10px; padding:12px 15px; font-size:13px; line-height:1.5; color:#374151; }
        .opt-label { font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase; margin-bottom:4px; }
        .opt-green  { background:rgba(34,197,94,.07);  border:1px solid rgba(34,197,94,.28); }
        .opt-green  .opt-label { color:#15803d; }
        .opt-yellow { background:rgba(234,179,8,.07);  border:1px solid rgba(234,179,8,.28); }
        .opt-yellow .opt-label { color:#a16207; }

        /* ── MAP ── */
        .map-legend {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 9px;
            padding: 0 2px;
        }
        .leg-item { display:flex; align-items:center; gap:6px; font-size:11.5px; color:var(--gray); }
        .leg-dot {
            width:12px; height:12px; border-radius:50%;
            border:2px solid white;
            box-shadow: 0 1px 4px rgba(0,0,0,.2);
            flex-shrink: 0;
        }

        .map-wrap {
            border-radius: 14px;
            overflow: hidden;
            height: 330px;
            margin-bottom: 36px;
            box-shadow: 0 3px 20px rgba(26,39,68,.11);
            border: 1px solid rgba(26,39,68,.07);
        }

        /* Leaflet popup override */
        .leaflet-popup-content-wrapper {
            border-radius: 10px !important;
            box-shadow: 0 4px 22px rgba(0,0,0,.16) !important;
            font-family: 'DM Sans', sans-serif !important;
            padding: 0 !important;
        }
        .leaflet-popup-content {
            font-size: 13px !important;
            line-height: 1.5 !important;
            color: #1a2744 !important;
            margin: 12px 16px !important;
        }
        .pop-badge {
            display: inline-block;
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 2px 8px;
            border-radius: 10px;
            margin-bottom: 5px;
        }
        .pop-attraction { background:rgba(26,39,68,.1);    color:#1a2744; }
        .pop-dining     { background:rgba(217,119,6,.12);  color:#92400e; }
        .pop-transport  { background:rgba(201,168,76,.15); color:#7a5c10; }

        /* ── FLOW BAR ── */
        .flow-bar {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 4px;
            background: var(--navy);
            border-radius: 12px;
            padding: 14px 20px;
            margin-top: 16px;
        }
        .flow-stop { font-size:12px; font-weight:600; color:var(--white); white-space:nowrap; }
        .flow-arr  { color:var(--gold); font-size:13px; margin:0 3px; }

        /* ── SEP ── */
        .sep {
            height: 1px;
            background: linear-gradient(to right, transparent, var(--gold), transparent);
            margin: 8px 0 38px;
        }

        /* ── TIPS GRID (general) ── */
        .sec-label {
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 16px;
            text-align: center;
        }
        .tips-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px,1fr));
            gap: 12px;
        }
        .tip-card {
            background: var(--white);
            border-radius: 13px;
            padding: 20px 16px;
            text-align: center;
            box-shadow: 0 2px 10px rgba(26,39,68,.05);
        }
        .tip-icon { font-size:26px; margin-bottom:9px; }
        .tip-text { font-size:12.5px; color:var(--gray); line-height:1.5; }

        @media (max-width:580px) {
            .day-num { font-size:40px; }
            .card { padding:20px 16px; }
            .city-btn { padding:10px 22px; }
            .map-wrap { height:260px; }
        }

        /* ══════════════════════════════════════════
           LA VIEW — scoped styles
        ══════════════════════════════════════════ */
        #losangeles { background: #F5F0E8; }

        .la-day-band {
            background: #2C2118;
            padding: 40px 40px 36px;
            position: relative;
        }
        .la-day-band-label {
            font-size: 10px; letter-spacing: 4px; text-transform: uppercase;
            color: #D4A853; margin-bottom: 10px;
        }
        .la-day-band-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(22px, 3.5vw, 38px);
            font-weight: 700; color: #FDFAF5; line-height: 1.1;
        }
        .la-day-band-sub {
            font-style: italic; font-size: 14px;
            color: rgba(253,250,245,0.45); margin-top: 8px;
        }
        .la-day-band-tags {
            display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px;
        }
        .la-day-band-tag {
            font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
            padding: 4px 10px; border: 1px solid rgba(212,168,83,0.3);
            color: rgba(253,250,245,0.5); border-radius: 1px;
        }
        .la-day-band-num {
            font-family: 'Playfair Display', serif;
            font-size: clamp(60px, 10vw, 110px); font-weight: 900;
            color: rgba(253,250,245,0.04); line-height: 1;
            position: absolute; right: 40px; top: 50%; transform: translateY(-50%);
            pointer-events: none;
        }

        .la-section { padding: 48px 40px; max-width: 960px; margin: 0 auto; }
        .la-section-divider {
            height: 1px;
            background: linear-gradient(to right, transparent, rgba(0,0,0,0.08), transparent);
            margin: 0 40px;
        }

        .la-tip-box {
            border-left: 3px solid #C4603A;
            background: rgba(196,96,58,0.05);
            padding: 16px 20px; margin: 16px 0;
            border-radius: 0 2px 2px 0;
            font-size: 13.5px; line-height: 1.7; color: #8A7968;
        }
        .la-tip-box strong { color: #2C2118; font-weight: 500; }

        .la-parking-box {
            background: #2C2118; color: #FDFAF5;
            padding: 28px 32px; border-radius: 2px; margin-bottom: 32px;
            display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: start;
        }
        .la-parking-icon { font-size: 28px; opacity: 0.8; }
        .la-parking-title {
            font-family: 'Playfair Display', serif; font-size: 18px;
            color: #D4A853; margin-bottom: 10px;
        }
        .la-parking-text { font-size: 13.5px; line-height: 1.8; color: rgba(253,250,245,0.7); font-weight: 300; }
        .la-parking-text strong { color: #FDFAF5; font-weight: 500; }

        .la-map-container {
            border-radius: 2px; overflow: hidden;
            border: 1px solid rgba(0,0,0,0.08);
            box-shadow: 0 4px 20px rgba(0,0,0,0.07); margin-bottom: 36px;
        }
        .la-map-label {
            background: #2C2118; padding: 12px 20px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .la-map-label-text { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: rgba(253,250,245,0.45); }
        .la-map-label-title { font-family: 'Playfair Display', serif; font-size: 14px; color: #FDFAF5; }

        .la-timeline { position: relative; padding-left: 32px; margin-bottom: 48px; }
        .la-timeline::before {
            content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 1px;
            background: linear-gradient(to bottom, #C4603A, #D4A853, #5B8FA8, transparent);
        }
        .la-tl-item { position: relative; padding: 0 0 32px 32px; }
        .la-tl-dot {
            position: absolute; left: -5px; top: 6px;
            width: 10px; height: 10px; border-radius: 50%;
            background: #C4603A; border: 2px solid #F5F0E8;
            box-shadow: 0 0 0 3px rgba(196,96,58,0.18);
        }
        .la-tl-time {
            font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
            color: #8A7968; margin-bottom: 7px;
        }
        .la-tl-card {
            background: #FDFAF5; border: 1px solid rgba(0,0,0,0.06);
            border-radius: 2px; padding: 20px 24px;
            box-shadow: 0 2px 14px rgba(0,0,0,0.04);
            transition: box-shadow 0.3s, transform 0.3s;
        }
        .la-tl-card:hover { box-shadow: 0 6px 28px rgba(0,0,0,0.09); transform: translateY(-2px); }
        .la-tl-name {
            font-family: 'Playfair Display', serif; font-size: 18px;
            font-weight: 600; color: #2C2118; margin-bottom: 7px; line-height: 1.2;
        }
        .la-tl-notes { font-size: 13.5px; line-height: 1.7; color: #8A7968; font-weight: 300; }
        .la-badge {
            display: inline-flex; align-items: center; gap: 5px;
            font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase;
            padding: 3px 9px; border-radius: 2px; margin-bottom: 10px; font-weight: 500;
        }
        .la-badge-place { background: rgba(122,140,110,0.12); color: #7A8C6E; }
        .la-badge-food  { background: rgba(212,168,83,0.12); color: #A07828; }
        .la-badge-tour  { background: rgba(168,68,42,0.1); color: #A8442A; }

        .la-food-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(240px,1fr));
            gap: 2px; margin-bottom: 32px;
        }
        .la-food-card {
            background: #FDFAF5; padding: 26px 22px;
            border: 1px solid rgba(0,0,0,0.05);
            transition: background 0.3s; position: relative; overflow: hidden;
        }
        .la-food-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
        }
        .la-food-card.eco::before { background: #7A8C6E; }
        .la-food-card.mid::before { background: #D4A853; }
        .la-food-card.top::before { background: #C4603A; }
        .la-food-card:hover { background: #E8DFD0; }
        .la-food-price { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px; font-weight: 500; }
        .la-food-card.eco .la-food-price { color: #7A8C6E; }
        .la-food-card.mid .la-food-price { color: #A07828; }
        .la-food-card.top .la-food-price { color: #A8442A; }
        .la-food-name { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: #2C2118; margin-bottom: 4px; }
        .la-food-range { font-size: 12px; color: #8A7968; margin-bottom: 10px; }
        .la-food-desc { font-size: 13px; line-height: 1.7; color: #8A7968; font-weight: 300; }

        /* ══════════════════════════════════════════
           ROADTRIP VIEW — scoped styles
        ══════════════════════════════════════════ */
        #roadtrip { background: #14110F; color: #F2EDE4; }

        .rt-intro {
            background: #1E1B18; padding: 40px;
            border-bottom: 1px solid rgba(255,255,255,0.07);
        }
        .rt-intro-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(32px,5vw,58px); font-weight: 700;
            color: #FAF7F2; line-height: 1; letter-spacing: -1px; margin-bottom: 8px;
        }
        .rt-intro-title span { color: #E8A020; }
        .rt-intro-sub { font-size: 13px; color: rgba(232,237,228,0.5); margin-bottom: 20px; }
        .rt-stats {
            display: flex; flex-wrap: wrap; gap: 0;
            border: 1px solid rgba(255,255,255,0.07); border-radius: 2px; overflow: hidden;
            max-width: 560px;
        }
        .rt-stat {
            flex: 1; padding: 14px 18px; border-right: 1px solid rgba(255,255,255,0.07);
            text-align: center; min-width: 100px;
        }
        .rt-stat:last-child { border-right: none; }
        .rt-stat-val { font-family: 'Playfair Display', serif; font-size: 24px; color: #E8A020; line-height: 1; display: block; }
        .rt-stat-lbl { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #8C8078; margin-top: 3px; display: block; }

        .rt-map-wrap { border-top: 1px solid rgba(255,255,255,0.07); border-bottom: 1px solid rgba(255,255,255,0.07); }
        .rt-map-header {
            background: #2A2320; padding: 13px 40px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .rt-map-title { font-family: 'Playfair Display', serif; font-size: 16px; letter-spacing: 1px; color: #E8A020; }
        .rt-map-sub { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: #8C8078; }

        .rt-summary {
            display: grid; grid-template-columns: repeat(3, 1fr);
            border-top: 1px solid rgba(255,255,255,0.07);
            border-bottom: 1px solid rgba(255,255,255,0.07);
        }
        .rt-summary-item {
            background: #2A2320; padding: 24px 32px;
            border-right: 1px solid rgba(255,255,255,0.07);
        }
        .rt-summary-item:last-child { border-right: none; }
        .rt-si-label { font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: #8C8078; margin-bottom: 8px; }
        .rt-si-val { font-family: 'Playfair Display', serif; font-size: 22px; color: #E8A020; line-height: 1; margin-bottom: 6px; }
        .rt-si-desc { font-size: 12.5px; color: rgba(242,237,228,0.5); line-height: 1.6; }

