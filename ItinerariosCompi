function makeIcon(point) {
    const c = COLORS[point.type] || COLORS.attraction;
    const label = point.n !== undefined ? point.n : '●';
    return L.divIcon({
        className: '',
        html: `<div style="width:30px;height:30px;border-radius:50%;
            background:${c.bg};color:${c.fg};
            display:flex;align-items:center;justify-content:center;
            font-family:'DM Sans',sans-serif;font-size:12px;font-weight:700;
            border:2.5px solid #fff;
            box-shadow:0 2px 8px rgba(0,0,0,.28);">${label}</div>`,
        iconSize: [30,30], iconAnchor:[15,15], popupAnchor:[0,-18]
    });
}

function makePopup(p) {
    const labels = { attraction:'Atracción', dining:'Gastronomía', transport:'Transporte' };
    return `<div>
        <span class="pop-badge pop-${p.type}">${labels[p.type]||'Atracción'}</span><br>
        <strong>${p.name}</strong>
        ${p.desc ? `<br><span style="color:#6b7280;font-size:12px;">${p.desc}</span>` : ''}
    </div>`;
}

// ── MAP INIT (Chicago/Seattle) ────────────────────────────────────────────────

const done = {};

function initMap(id, data) {
    if (done[id]) return;
    done[id] = true;

    const map = registerMap(L.map(id, { scrollWheelZoom: false }));

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19
    }).addTo(map);

    const bounds = [];
    data.points.forEach(p => {
        L.marker([p.lat, p.lng], { icon: makeIcon(p) })
            .addTo(map)
            .bindPopup(makePopup(p), { maxWidth:230 });
        bounds.push([p.lat, p.lng]);
    });

    if (data.route && data.route.length > 1) {
        L.polyline(data.route, {
            color: '#c9a84c', weight: 3.5,
            opacity: 0.75, dashArray: '9,5'
        }).addTo(map);
    }

    map.fitBounds(bounds, { padding:[36,36] });
}

// ── LA MAPS ───────────────────────────────────────────────────────────────────

function makeLaIcon(num, color) {
    return L.divIcon({
        className: '',
        html: `<div style="width:30px;height:30px;border-radius:50% 50% 50% 0;
            background:${color};transform:rotate(-45deg);
            border:2.5px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,0.3);
            display:flex;align-items:center;justify-content:center;">
            <span style="transform:rotate(45deg);color:#fff;font-size:11px;font-weight:700;">${num}</span></div>`,
        iconSize:[30,30], iconAnchor:[15,30], popupAnchor:[0,-32]
    });
}

function initLaMap(containerId, center, zoom, stops) {
    if (done[containerId]) return;
    done[containerId] = true;
    const map = registerMap(L.map(containerId, { scrollWheelZoom: false }));
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution:'© OpenStreetMap © CARTO', maxZoom:19
    }).addTo(map);
    map.setView(center, zoom);
    const latlngs = stops.map(s => [s.lat, s.lng]);
    L.polyline(latlngs, { color:'#C4603A', weight:2.5, opacity:0.55, dashArray:'6,8' }).addTo(map);
    stops.forEach((s, i) => {
        L.marker([s.lat, s.lng], { icon: makeLaIcon(i+1, s.color || '#C4603A') })
            .addTo(map)
            .bindPopup(`<strong style="font-size:13px;">${s.name}</strong><br><span style="font-size:11px;color:#8A7968;">${s.time}</span>`, { maxWidth:220 });
    });
}

