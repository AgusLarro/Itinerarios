        { latlng:[35.1428,-120.6413], emoji:'🌊', color:'#5B8FA8', title:'Pismo Beach (variante)', sub:'Opcional · ~30-45 min', variant:true },
        { latlng:[34.5958,-120.1346], emoji:'⚓', color:'#5B9FB8', title:'Solvang', sub:'~6:00 PM · 45-60 min' },
        { latlng:[34.4208,-119.6982], emoji:'🌴', color:'#C85A2A', title:'Santa Bárbara', sub:'~7:00 PM · Cena' },
        { latlng:[34.0007,-118.4512], emoji:'★', color:'#E8A020', title:'Marina del Rey — LA', sub:'~9:00 PM · Destino final', big:true },
    ];

    function makeRtIcon(emoji, color, size, isVariant) {
        const border = isVariant ? 'rgba(91,159,184,0.8)' : 'rgba(255,255,255,0.75)';
        const opacity = isVariant ? '0.7' : '1';
        return L.divIcon({
            className:'',
            html:`<div style="width:${size}px;height:${size}px;background:${color};border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:2px solid ${border};box-shadow:0 3px 10px rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;opacity:${opacity};"><span style="transform:rotate(45deg);font-size:${size*0.38}px;line-height:1;">${emoji}</span></div>`,
            iconSize:[size,size], iconAnchor:[size/2,size], popupAnchor:[0,-size-4]
        });
    }

    rtStops.forEach(s => {
        const sz = s.big ? 42 : 34;
        L.marker(s.latlng, { icon: makeRtIcon(s.emoji, s.color, sz, s.variant) })
            .addTo(map)
            .bindPopup(`<div style="font-family:sans-serif;min-width:160px;"><strong style="font-size:13px;color:#1E1B18;">${s.title}</strong><br><span style="font-size:11px;color:#8C8078;">${s.sub}</span></div>`, { maxWidth:240 });
    });

    // Tolls
    [{latlng:[34.052,-118.430],label:'⚡ I-405 Express Lanes (opcional)',detail:'Carriles rápidos opcionales al llegar a LA. $3-8 si los usás. Los carriles normales son gratis.',free:false}].forEach(t => {
        const ic = L.divIcon({ className:'', html:`<div style="width:26px;height:26px;border-radius:4px;background:#4A3000;border:2px solid #E8A020;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#E8A020;box-shadow:0 2px 6px rgba(0,0,0,0.5);">$</div>`, iconSize:[26,26], iconAnchor:[13,13], popupAnchor:[0,-16] });
        L.marker(t.latlng, { icon:ic }).addTo(map).bindPopup(`<div style="font-family:sans-serif;min-width:180px;"><strong style="font-size:12px;">${t.label}</strong><br><span style="font-size:11px;color:#6A6060;">${t.detail}</span></div>`, { maxWidth:240 });
    });

    const mainWaypoints = [
        [38.5449,-121.7405],[38.6954,-121.5908],[36.9741,-120.1000],
        [35.6269,-120.6911],[34.5958,-120.1346],[34.4208,-119.6982],
        [34.2200,-119.1800],[34.0007,-118.4512]
    ];
    const pismoVariant = [[35.6269,-120.6911],[35.1428,-120.6413],[34.5958,-120.1346]];

    async function fetchRoute(wpts) {
        const coords = wpts.map(w=>`${w[1]},${w[0]}`).join(';');
        try {
            const r = await fetch(`https://router.project-osrm.org/route/v1/driving/${coords}?overview=full&geometries=geojson`);
            const d = await r.json();
            if (d.routes&&d.routes[0]) return d.routes[0].geometry.coordinates.map(c=>[c[1],c[0]]);
        } catch(e) { console.warn('OSRM',e); }
        return null;
    }

    async function drawRt() {
        const mc = await fetchRoute(mainWaypoints);
        if (mc) {
            L.polyline(mc,{color:'#000',weight:6,opacity:0.35}).addTo(map);
            L.polyline(mc,{color:'#E8A020',weight:3,opacity:0.85}).addTo(map);
        } else {
            L.polyline(mainWaypoints,{color:'#E8A020',weight:3,opacity:0.65,dashArray:'8,12'}).addTo(map);
        }
        const pc = await fetchRoute(pismoVariant);
        if (pc) L.polyline(pc,{color:'#5B8FA8',weight:2,opacity:0.55,dashArray:'5,9'}).addTo(map);
        map.fitBounds(L.latLngBounds(rtStops.map(s=>s.latlng)), {padding:[40,40]});
    }
    drawRt();
}

